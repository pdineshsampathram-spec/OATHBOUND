; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="OATHBOUND"
config/description="3D multiplayer medieval fantasy arena fighting game"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/lobby.tscn"
run/max_fps=60

[autoload]

GraphicsManager="*res://scripts/graphics_settings.gd"
PerformanceOverlay="*res://scenes/debug/performance_overlay.tscn"
NetworkManager="*res://scripts/networking/network_manager.gd"
CombatTimeController="*res://scripts/combat/combat_time_controller.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/vsync/vsync_mode=1

[editor_plugins]

enabled=PackedStringArray("res://addons/asset_validator/plugin.cfg")

[input]

