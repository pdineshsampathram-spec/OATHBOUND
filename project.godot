; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="OATHBOUND"
config/description="3D multiplayer medieval fantasy arena fighting game"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60

[autoload]

PerformanceOverlay="*res://scenes/debug/performance_overlay.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/vsync/vsync_mode=1

[input]

toggle_perf_overlay={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194334,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=false
